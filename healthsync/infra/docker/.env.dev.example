# HealthSync local Docker Compose environment.
# Copy to infra/docker/.env.dev and replace values before starting.

POSTGRES_USER=healthsync
POSTGRES_PASSWORD=healthsync_dev_password
POSTGRES_DB=healthsync
DATABASE_URL=postgresql://healthsync:healthsync_dev_password@postgres:5432/healthsync
REDIS_URL=redis://redis:6379
JWT_SECRET=healthsync_local_only_change_before_shared_use_32_chars
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
NODE_ENV=development
LOG_LEVEL=debug

KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC_VITALS=hs.vitals.ingested
KAFKA_TOPIC_ALERTS=hs.alert.triggered
KAFKA_GROUP_ID_ALERT=alert-service-group
MQTT_BROKER=tcp://emqx:1883
MQTT_CLIENT_ID=iot-ingestion-01
MQTT_USERNAME=
MQTT_PASSWORD=

AUTH_PORT=3001
PATIENT_PORT=3002
CONSULTATION_PORT=3003
PRESCRIPTION_PORT=3004
AMBULANCE_PORT=3005
REFERRAL_PORT=3006
HOSPITAL_PORT=3007
PHARMACY_PORT=3008
NOTIFICATION_PORT=3009
INTEGRATION_PORT=3010
IOT_PORT=4001
ALERT_PORT=4002

# Optional local integrations. Leave blank to keep external integrations fail-closed.
SATUSEHAT_BASE_URL=https://api-satusehat.kemkes.go.id
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=
BPJS_BASE_URL=https://apijkn.bpjs-kesehatan.go.id
BPJS_CONS_ID=
BPJS_SECRET_KEY=
BPJS_USER_KEY=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMS_API_KEY=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=noreply@healthsync.local
SMTP_PASS=
