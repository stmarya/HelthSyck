              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patient_id}}\",\n  \"chiefComplaint\": \"Merasa pusing dan mual sejak 2 hari yang lalu\",\n  \"symptomData\": {\n    \"symptoms\": [\"headache\", \"nausea\"],\n    \"duration\": \"2 days\",\n    \"severity\": \"moderate\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => { pm.response.to.have.status(201); });",
