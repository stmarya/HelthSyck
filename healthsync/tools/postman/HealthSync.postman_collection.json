  "item": [
    {
      "name": "🔐 Auth Flow",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_auth}}/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"status ok\", () => { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "url": "{{base_auth}}/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pasien.test@healthsync.id\",\n  \"password\": \"Test@1234\",\n  \"name\": \"Budi Santoso\",\n  \"role\": \"PATIENT\",\n  \"phone\": \"08123456789\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => { pm.response.to.have.status(201); });",
                  "pm.test(\"Has accessToken\", () => { pm.expect(pm.response.json().data?.accessToken).to.be.a('string'); });",
                  "pm.test(\"Has refreshToken\", () => { pm.expect(pm.response.json().data?.refreshToken).to.be.a('string'); });",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"access_token\", d?.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", d?.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Doctor",
          "request": {
            "method": "POST",
            "url": "{{base_auth}}/v1/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dokter.test@healthsync.id\",\n  \"password\": \"Test@1234\",\n  \"name\": \"Dr. Siti Rahayu\",\n  \"role\": \"DOCTOR\",\n  \"phone\": \"08234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => { pm.response.to.have.status(201); });",
                  "pm.test(\"Has doctor accessToken\", () => { pm.expect(pm.response.json().data?.accessToken).to.be.a('string'); });",
                  "pm.collectionVariables.set(\"doctor_access_token\", pm.response.json().data?.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_auth}}/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pasien.test@healthsync.id\",\n  \"password\": \"Test@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Role is PATIENT\", () => { pm.expect(pm.response.json().data?.role).to.eql(\"PATIENT\"); });",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"access_token\", d?.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", d?.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{base_auth}}/v1/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"data.userId exists\", () => { pm.expect(pm.response.json().data?.userId).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_auth}}/v1/auth/refresh",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => { pm.response.to.have.status(200); });",
                  "const d = pm.response.json().data;",
                  "if (d?.accessToken) pm.collectionVariables.set(\"access_token\", d.accessToken);",
                  "if (d?.refreshToken) pm.collectionVariables.set(\"refresh_token\", d.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
