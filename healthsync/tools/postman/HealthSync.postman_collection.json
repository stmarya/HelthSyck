{
  "info": {
    "name": "HealthSync Indonesia API",
    "_postman_id": "healthsync-v1-collection",
    "description": "Complete API test collection for HealthSync. Run flows in order. Auth flow must run first to populate tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_auth", "value": "http://localhost:3001" },
    { "key": "base_patient", "value": "http://localhost:3002" },
    { "key": "base_consultation", "value": "http://localhost:3003" },
    { "key": "base_prescription", "value": "http://localhost:3004" },
    { "key": "base_ambulance", "value": "http://localhost:3005" },
    { "key": "base_referral", "value": "http://localhost:3006" },
    { "key": "base_hospital", "value": "http://localhost:3007" },
    { "key": "base_pharmacy", "value": "http://localhost:3008" },
    { "key": "base_notification", "value": "http://localhost:3009" },
    { "key": "base_alert", "value": "http://localhost:4002" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "doctor_access_token", "value": "" },
    { "key": "patient_id", "value": "" },
    { "key": "consultation_id", "value": "" },
    { "key": "prescription_id", "value": "" },
    { "key": "alert_id", "value": "" },
    { "key": "ambulance_id", "value": "" },
    { "key": "referral_id", "value": "" },
    { "key": "hospital_id", "value": "a0000000-0000-0000-0000-000000000001" }
