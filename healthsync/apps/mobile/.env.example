# HealthSync Mobile — Environment (EXAMPLE)
# Copy this file to .env before running
#
# Development (Docker local):
API_HOST=localhost
AUTH_PORT=3001
PATIENT_PORT=3002
CONSULTATION_PORT=3003
PRESCRIPTION_PORT=3004
AMBULANCE_PORT=3005
REFERRAL_PORT=3006
HOSPITAL_PORT=3007
PHARMACY_PORT=3008
IOT_PORT=4001
ALERT_PORT=4002
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Production:
# Use a single ingress URL for production so service-specific ports are not
# exposed to mobile clients:
# flutter build apk --dart-define=API_BASE_URL=https://api.healthsync.id
