# Command Center runtime configuration
# Development may use simulator mode. Production/staging must use a live provider.
VITE_MAP_PROVIDER=simulator
VITE_MAP_STYLE_URL=
VITE_MAP_ACCESS_TOKEN=
VITE_ROUTING_URL=
VITE_LOCATION_STALE_AFTER_MS=15000

# Server-side Vite proxy targets (Docker/service DNS or localhost ports)
VITE_AUTH_TARGET=http://localhost:3001
VITE_PATIENT_TARGET=http://localhost:3002
VITE_CONSULTATION_TARGET=http://localhost:3003
VITE_AMBULANCE_TARGET=http://localhost:3005
VITE_HOSPITAL_TARGET=http://localhost:3007
VITE_PHARMACY_TARGET=http://localhost:3008
VITE_REALTIME_TARGET=http://localhost:3011

# Communication readiness
# Use short-lived TURN credentials in staging/production; do not commit static secrets.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
