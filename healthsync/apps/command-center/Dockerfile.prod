# Command Center production image: compile Vite assets and serve with unprivileged nginx.
FROM node:20-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/command-center/package.json ./apps/command-center/
COPY apps/admin/package.json ./apps/admin/
COPY services/auth-service/package.json ./services/auth-service/
COPY services/patient-service/package.json ./services/patient-service/
COPY services/consultation-service/package.json ./services/consultation-service/
COPY services/prescription-service/package.json ./services/prescription-service/
COPY services/ambulance-service/package.json ./services/ambulance-service/
COPY services/referral-service/package.json ./services/referral-service/
COPY services/hospital-service/package.json ./services/hospital-service/
COPY services/pharmacy-service/package.json ./services/pharmacy-service/
COPY services/notification-service/package.json ./services/notification-service/
COPY services/integration-service/package.json ./services/integration-service/

RUN npm ci --ignore-scripts --no-audit --no-fund

COPY packages/shared ./packages/shared
RUN npm run build --workspace=packages/shared
COPY apps/command-center ./apps/command-center
RUN npm run build --workspace=apps/command-center

FROM nginxinc/nginx-unprivileged:1.27-alpine
USER root
COPY apps/command-center/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/command-center/docker-entrypoint-runtime-config.sh /docker-entrypoint.d/40-healthsync-runtime-config.sh
COPY --from=build /app/apps/command-center/dist /usr/share/nginx/html
RUN chmod 755 /docker-entrypoint.d/40-healthsync-runtime-config.sh \
    && chown -R 101:0 /usr/share/nginx/html \
    && chmod -R g+rwX /usr/share/nginx/html
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1
